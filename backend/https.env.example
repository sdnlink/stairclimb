# Paths only, no private keys or credentials. Source after configuring PostgreSQL.
# For public certificates, server.pem contains the leaf plus intermediate chain.
export STAIRCLIMB_TLS_CERT=/path/to/private/server-chain.pem
export STAIRCLIMB_TLS_KEY=/path/to/private/server-key.pem
export STAIRCLIMB_HOST=127.0.0.1
export STAIRCLIMB_PORT=8443
# Both TLS paths are required together. Invalid/missing material fails startup.
# Local development: use . ./.runtime/tls/server.env from scripts/dev_tls.py instead.
