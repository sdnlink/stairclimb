# 复制为被忽略的 .env 后编辑并 source；本示例没有真实密钥。
export STAIRCLIMB_HOST=127.0.0.1
export STAIRCLIMB_PORT=8787
export DATABASE_URL=postgresql://stairclimb:CHANGE_ME@127.0.0.1:5432/stairclimb

# Per-process pool (including in-flight connection creation). Invalid values fail startup.
export STAIRCLIMB_DB_POOL_MAX=8
export STAIRCLIMB_DB_POOL_TIMEOUT_MS=1500
