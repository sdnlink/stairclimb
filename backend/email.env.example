# No real credentials. Source this alongside .runtime/postgres.env.
# Loopback capture never forwards messages to an external mailbox.
export SMTP_MODE=local-capture
export SMTP_HOST=127.0.0.1
export SMTP_PORT=1025
export SMTP_FROM=noreply@stairclimb.test

# Production: mode=tls (implicit TLS) or starttls (mandatory upgrade), never plain.
# export SMTP_MODE=starttls
# export SMTP_HOST=smtp.example.com
# export SMTP_PORT=587
# export SMTP_FROM=noreply@example.com
# export SMTP_USERNAME=CHANGE_ME
# export SMTP_PASSWORD=CHANGE_ME
# Put production credentials in an ignored local file/environment, not this example.
