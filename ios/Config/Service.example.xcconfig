// No credentials. Set the actual address in the app's 今日楼层榜 registration form.
// This is a documentation example, not a build-time override of persisted identity.
// All API addresses require HTTPS, including local Debug development.
// In xcconfig values, write a URL with the slash escaping below to avoid // comments.
STAIRCLIMB_API_BASE_URL = https:/$()/example.invalid
